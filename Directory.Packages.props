<Project>
  <Import Project="RobustToolbox/Directory.Packages.props" />
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="NUnit.ConsoleRunner" Version="3.15.0" />
    <PackageVersion Include="Byond.TopicSender" Version="8.0.1" />
    <PackageVersion Include="OpenDreamByondApi" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!--
    ImageSharp advisories fixed only in 4.x, which needs a license key to build. None are reachable:
    IccProfile.Entries and HistogramEqualization are never used, TIFF is never encoded,
    and icons only decode as PNG/BMP.
    TODO: Remove once RobustToolbox suppresses these itself.
    -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>