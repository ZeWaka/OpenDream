// Blurs along lines from (x, y). The sigma is `size` times the distance from it.

light_mode unshaded;
blend_mode none;

uniform highp float x;
uniform highp float y;
uniform highp float size;
uniform highp float offset;
uniform highp float[10] weights;
uniform highp float[10] offsets;
uniform highp vec2 canvasPadding;

void fragment() {
    highp vec2 texSize = 1.0 / TEXTURE_PIXEL_SIZE;

    highp vec2 dir = UV * texSize - (texSize * 0.5 + vec2(x + canvasPadding.x, y - canvasPadding.y));
    highp float len = length(dir);
    highp float reach = len - max(offset, 0.0);

    highp vec4 sum = texture2D(TEXTURE, UV);

    if (size != 0.0 && reach > 0.0) {
        highp vec2 stride = dir * (reach / len * size / 6.0) * TEXTURE_PIXEL_SIZE;

        sum *= weights[0];
        for (int i = 1; i < 10; i++) {
            highp vec2 o = stride * offsets[i];
            sum += (texture2D(TEXTURE, UV - o) + texture2D(TEXTURE, UV + o)) * weights[i];
        }
    }

    COLOR = sum;
}
